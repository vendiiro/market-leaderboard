{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News30",
  "description": "Headlines from the last 30 days for the shares the owner holds, from Google News RSS (scripts/news30.py). Private (names the holdings) and git-ignored. News flow, not sentiment; headlines are third-party text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asof", "source", "companies", "failed"],
  "properties": {
    "schema_version": { "const": 1 },
    "asof": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string" },
    "companies": { "type": "array", "items": { "$ref": "#/$defs/company" } },
    "failed": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ticker", "reason"],
        "properties": { "ticker": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "source", "url", "date"],
      "properties": {
        "title": { "type": "string" },
        "source": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "name", "asof", "count", "capped", "per_week", "items"],
      "properties": {
        "ticker": { "type": "string" },
        "name": { "type": "string" },
        "asof": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "capped": { "type": "boolean", "description": "The feed was full (100 items): counts and the weekly split lean to recent days." },
        "per_week": { "description": "Headlines per week, oldest week first; the last entry is the most recent 7 days.", "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0 } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    }
  }
}
