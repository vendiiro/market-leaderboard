{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio",
  "description": "Inputs for the mix view. cov and corr are square matrices in the order of risk_tickers: annualised covariance and correlation of weekly EUR returns over one shared window. Estimates, not forecasts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asof", "window", "tickers", "risk_tickers", "cov", "corr", "no_risk_data"],
  "properties": {
    "schema_version": { "const": 2 },
    "asof": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "weeks"],
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] },
        "weeks": { "type": "integer" }
      }
    },
    "tickers": {
      "description": "Every ticker with data tonight, once. vol_eur is null for a ticker without risk data.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "lists", "sector", "country", "currency", "vol_eur"],
        "properties": {
          "ticker": { "type": "string" },
          "name": { "type": "string" },
          "lists": { "type": "array", "items": { "type": "string" } },
          "sector": { "type": ["string", "null"] },
          "country": { "type": ["string", "null"] },
          "currency": { "type": ["string", "null"] },
          "vol_eur": { "type": ["number", "null"] }
        }
      }
    },
    "risk_tickers": { "type": "array", "items": { "type": "string" } },
    "cov": { "$ref": "#/$defs/matrix" },
    "corr": { "$ref": "#/$defs/matrix" },
    "no_risk_data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "reason"],
        "properties": { "ticker": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "matrix": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
  }
}
