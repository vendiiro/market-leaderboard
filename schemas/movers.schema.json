{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Movers",
  "description": "Largest 1-day moves across all watchlists (each ticker once, stale rows never listed) and the rows the dip rule flags. The dip rule is an untested screen rule.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asof", "gainers", "losers", "alerts"],
  "properties": {
    "schema_version": { "const": 1 },
    "asof": { "$ref": "#/$defs/day" },
    "gainers": { "type": "array", "items": { "$ref": "#/$defs/mover" } },
    "losers": { "type": "array", "items": { "$ref": "#/$defs/mover" } },
    "alerts": { "type": "array", "items": { "$ref": "#/$defs/alert" } }
  },
  "$defs": {
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "name", "lists", "currency", "last_bar", "ret_1d"],
      "properties": {
        "ticker": { "type": "string" },
        "name": { "type": "string" },
        "lists": { "type": "array", "items": { "type": "string" } },
        "currency": { "type": ["string", "null"] },
        "last_bar": { "$ref": "#/$defs/day" },
        "ret_1d": { "type": ["number", "null"] }
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "name", "lists", "currency", "last_bar", "ret_1d", "reasons", "label", "q_passed", "q_scored"],
      "properties": {
        "ticker": { "type": "string" },
        "name": { "type": "string" },
        "lists": { "type": "array", "items": { "type": "string" } },
        "currency": { "type": ["string", "null"] },
        "last_bar": { "$ref": "#/$defs/day" },
        "ret_1d": { "type": ["number", "null"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "label": { "type": "string" },
        "q_passed": { "type": "integer" },
        "q_scored": { "type": "integer" }
      }
    }
  }
}
